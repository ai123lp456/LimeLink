<resources>
    <style name="Theme.LimeLink" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/lime</item>
        <item name="colorPrimaryVariant">@color/lime_deep</item>
        <item name="colorOnPrimary">@color/ink</item>
        <item name="colorSecondary">@color/lime_deep</item>
        <item name="colorOnSecondary">@color/ink</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
    </style>

    <!-- 块面标题字：窄体无衬线，字号大，字重黑 -->
    <style name="Text.Block.Title" parent="">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Text.Block.Section" parent="">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="Text.Block.Mono" parent="">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.14</item>
    </style>

    <style name="Text.Block.Body" parent="">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Text.Block.Hint" parent="">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">11.5sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Widget.Block.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/btn_block_lime</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
