<resources>
    <!-- 瑞士极简：纸底墨字，无圆角无阴影；强调色只用于「已连接」小圆点 -->
    <style name="Theme.LimeLink" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/ink</item>
        <item name="colorPrimaryVariant">@color/ink2</item>
        <item name="colorOnPrimary">@color/paper</item>
        <item name="colorSecondary">@color/ink</item>
        <item name="colorOnSecondary">@color/paper</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
    </style>

    <style name="Text.Block.Title" parent="">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Text.Block.Section" parent="">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="Text.Block.Mono" parent="">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.14</item>
    </style>

    <style name="Text.Block.Body" parent="">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Text.Block.Hint" parent="">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">11.5sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
</resources>
