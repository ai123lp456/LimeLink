<?xml version="1.0" encoding="utf-8"?>
<!-- 单台「附近的电脑」：一行清单，无卡片无阴影 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDevName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LimeLink-PC"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvDevMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="192.168.1.5:8787"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvDevHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text=""
            android:textColor="@color/subtle"
            android:textSize="10.5sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDevState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="可连接"
        android:textColor="@color/muted"
        android:textSize="10sp"
        android:fontFamily="monospace" />

    <TextView
        android:id="@+id/btnDevConnect"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="2dp"
        android:text="连接"
        android:textColor="@color/ink"
        android:textSize="12.5sp"
        android:textStyle="bold" />
</LinearLayout>
