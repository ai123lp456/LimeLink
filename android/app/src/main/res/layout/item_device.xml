<?xml version="1.0" encoding="utf-8"?>
<!-- 单台「附近的电脑」卡片：高饱和块面 + 硬投影 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_block"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvDevIco"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_tag_paper"
            android:gravity="center"
            android:text="▭"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/ink"
            android:fontFamily="monospace" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDevName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LimeLink-PC"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvDevMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="192.168.1.5:8787"
                style="@style/Text.Block.Mono" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDevState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tag_paper"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="可连接"
            android:textColor="@color/ink"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnDevConnect"
            style="@style/Widget.Block.Button"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="连接这台电脑" />

        <TextView
            android:id="@+id/tvDevHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text=""
            style="@style/Text.Block.Hint" />
    </LinearLayout>
</LinearLayout>
